<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/etNombre" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Nombre del Cliente" />

    <EditText android:id="@+id/etMonto" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Monto ($)" android:inputType="numberDecimal" />

    <EditText android:id="@+id/etPlazo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Plazo (Meses)" android:inputType="number" />

    <Button android:id="@+id/btnGuardar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Guardar Préstamo" />

    <ImageView
        android:id="@+id/ivCliente"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:contentDescription="Cliente"
        android:src="@drawable/cliente" />
</LinearLayout>